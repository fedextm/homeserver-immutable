{
  "ignition": {
    "version": "3.6.0"
  },
  "kernelArguments": {
    "shouldExist": [
      "mitigations=off",
      "net.ifnames=0",
      "biosdevname=0",
      "selinux=0",
      "audit=0"
    ],
    "shouldNotExist": [
      "mitigations=auto,nosmt"
