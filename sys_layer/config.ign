  "systemd": {
    "units": [
      {
        "enabled": false,
        "name": "zincati.service"
      },
      {
        "enabled": true,
        "name": "podman-restart.service"
      },
      {
        "enabled": false,
        "name": "systemd-resolved.service"
      },
      {
        "contents": "[Unit]\nDescription=Mount Data Volume\n\n[Mount]\nWhat=/dev/mapper/vg_data-lv_data\nWhere=/var/mnt/data\nType=ext4\nOptions=nofail,noatime,discard,errors=remount-ro\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "var-mnt-data.mount"
      },
      {
        "contents": "[Unit]\nDescription=Mount Data Volume\n\n[Mount]\nWhat=/dev/mapper/vg_backup-lv_backup\nWhere=/var/mnt/mirror\nType=ext4\nOptions=nofail,noatime,discard,errors=remount-ro\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "var-mnt-mirror.mount"
      }
    ]
